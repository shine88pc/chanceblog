---
layout: null
sitemap: false
---
[
{% assign visible_posts = site.posts %}
{% for post in visible_posts %}
{% assign post_name = post.path | split: '/' | last %}
{% assign category = post.category %}
{% if category == nil or category == '' %}
  {% assign category = post.categories | first %}
{% endif %}
{% if category == nil or category == '' %}
  {% assign category = 'General' %}
{% endif %}
{% assign lang = post.lang %}
{% if lang == nil or lang == '' %}
  {% assign post_path_lower = post.path | downcase %}
  {% assign post_name_lower = post_name | downcase %}
  {% if post_path_lower contains '/en ' or post_name_lower contains '-en-' %}
    {% assign lang = 'en' %}
  {% else %}
    {% assign lang = 'kr' %}
  {% endif %}
{% endif %}
  {
    "path": {{ post.path | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "absoluteUrl": {{ post.url | absolute_url | jsonify }},
    "name": {{ post_name | jsonify }},
    "title": {{ post.title | default: post_name | jsonify }},
    "category": {{ category | jsonify }},
    "lang": {{ lang | downcase | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "image": {{ post.image | default: "" | jsonify }},
    "tags": {{ post.tags | default: empty | jsonify }},
    "content": {{ post.content | jsonify }},
    "contentIsHtml": true,
    "previewText": {{ post.excerpt | strip_html | normalize_whitespace | truncate: 180 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
